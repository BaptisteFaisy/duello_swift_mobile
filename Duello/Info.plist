<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Schéma de retour du navigateur Google : client iOS inversé,
	     exigé par GoogleSignIn (fusionné avec l'Info.plist généré). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.283336474401-hbo36u49j767lqknahakr2937mfa6amn</string>
			</array>
		</dict>
		<dict>
			<!-- Retour du lien de réinitialisation de mot de passe servi par
			     le backend de développement (`DUELLO_PASSWORD_RESET_APP_SCHEME=duello-dev`).
			     Le schéma de production `duello` sera à ajouter ici lors de la bascule prod. -->
			<key>CFBundleURLName</key>
			<string>fr.duello.app.dev</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>duello-dev</string>
			</array>
		</dict>
	</array>
	<!-- Photo d'une copie ou d'un exercice (transcription, correction). -->
	<key>NSCameraUsageDescription</key>
	<string>Duello utilise l'appareil photo pour photographier vos copies et exercices afin de les transcrire et de les corriger.</string>
	<!-- Choix d'une photo existante (copie, avatar, événement). -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Duello accède à vos photos pour choisir une copie à corriger ou une image de profil.</string>
	<!-- Dictée d'une formule (moteur AVAudioEngine + SFSpeechRecognizer). -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Duello utilise le microphone pour la dictée des formules mathématiques.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Duello utilise la reconnaissance vocale pour transcrire vos formules dictées.</string>
	<!-- HTTPS uniquement, aucun chiffrement non exempté : pas de
	     questionnaire de conformité d'export à chaque upload TestFlight. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
